# Example only. Keep real local config outside Git; never paste credentials in chat.
KHOHOC_MODE=development
KHOHOC_DATABASE_URL=sqlite:////workspace/state/khohoc.db
KHOHOC_ADMIN_TOKEN=replace-with-a-local-random-token-at-least-24-characters
API_BASE_URL=http://127.0.0.1:8000
# Production deployment and Supabase adapters remain disabled.
# No service-role or AI key belongs in Flutter build defines or browser assets.

# Local manager bootstrap only; generated private file, never commit its contents.
KHOHOC_MANAGER_CREDENTIALS_FILE=/workspace/state/TAI-KHOAN-QUAN-LY.txt

# Optional backend-only text tutor. OCR in web/Windows needs none of these.
# Disabled by default; no real provider has been validated. See docs/AI_OCR.md.
# The Windows launcher reads inherited environment variables, not this file.
KHOHOC_AI_ENABLED=false
KHOHOC_AI_BASE_URL=https://api.openai.com/v1
KHOHOC_AI_MODEL=
# Use a separate regular file outside Git/web assets/ZIP, never the key itself.
# POSIX: owner-readable 0400/0600; shared Docker API runs UID/GID 10001:10001.
# Windows: restrict the file/directory ACL to the operator.
KHOHOC_AI_API_KEY_FILE=
KHOHOC_AI_DAILY_USER_LIMIT=10
KHOHOC_AI_DAILY_SERVER_LIMIT=100
KHOHOC_AI_OUTPUT_TOKENS=800
